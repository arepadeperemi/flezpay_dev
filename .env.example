# ══════════════════════════════════════════════════════════════════════════════
# FlezPay Business OS — Environment Configuration Template
# (Copy this file to .env and populate with your own credentials)
# ══════════════════════════════════════════════════════════════════════════════

# ── Django Core ─────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-replace-with-a-secure-random-key-for-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,test.localhost,.flezpay.com
SITE_DOMAIN=flezpay.com
APP_VERSION=2.4.1
ENC_KEY=your_32_byte_base64_encryption_key_here

# ── Email Configuration ───────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=Flezpay <your_email@gmail.com>
EMAIL_TIMEOUT=5

# ── Stellar Stablecoin Integration ──────────────────────────────────────────
# Network: 'testnet' or 'public'
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
# Central Stellar Wallet Address for sweeping merchant funds
GENERATED_USDC_KEY=GA5XNZ4VO7MBDWOMQ2ELWIB4CMDQXRBPJMWQLWUH6GOW2W5AC2HGOJA

# ── Arc Network (Circle EVM / CCTP) ─────────────────────────────────────────
ARC_ENABLED=true
ARC_NETWORK=testnet
ARC_CHAIN_ID=5042002
ARC_CHAIN_ID_HEX=0x4cef12
ARC_RPC_URL=https://rpc-testnet.arc.network
ARC_WS_URL=wss://rpc-testnet.arc.network/ws
ARC_USDC_ADDRESS=0x360E2aE7C416b0b2eFd1FE91f3B29497e01d67eF
ARC_USDC_DECIMALS=6
ARC_EXPLORER_URL=https://explorer-testnet.arc.network
ARC_PAYMENT_EXPIRY_MINUTES=15
ARC_SCANNER_BATCH_SIZE=50
ARC_SCANNER_INTERVAL_SECONDS=5
# Master seed for HD wallet address derivation (encrypt with ENC_KEY)
ARC_HD_WALLET_SEED=your_arc_hd_wallet_seed_here

# ── Circle USDC Developer-Controlled Wallets ────────────────────────────────
CIRCLE_USDC_API_KEY=your_circle_api_key_here
CIRCLE_USDC_TESTNET=your_circle_testnet_api_key_here
CIRCLE_BASE_URL=https://api.circle.com/v1
HEX_ENCODED_ENTITY_SECRET_KEY=your_64_character_hex_entity_secret_key_here

# ── Paystack Payments (Fiat Fallback) ───────────────────────────────────────
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_PRIVATE_KEY=sk_test_your_paystack_secret_key

# ── Bank & PSB Transfer API ─────────────────────────────────────────────────
PSB_PUBLIC_KEY=your_psb_public_key
PSB_PRIVATE_KEY=your_psb_private_key
PSB_WEBHOOK_PASSWORD=your_webhook_password
PSB_BAN=your_psb_ban
PSB_BBC=your_psb_bbc
NUBAN_API_KEY=your_nuban_api_key
SMS_API_USERNAME=your_sms_username
SMS_API_PASSWORD=your_sms_password

# ── Cloudflare & Cloud Object Storage (R2 / S3) ─────────────────────────────
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_TARGET_DOMAIN=flezpay.com
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_BUCKET=flezpay-media
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com

# ── AI Services ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key
DEEPSEEK_KEY=your_deepseek_api_key
GEMINI_API_KEY=your_gemini_api_key
OLLAMA_MODEL=mistral

# ── Authentication & Logistics ──────────────────────────────────────────────
GOOGLE_AUTH_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_AUTH_SECRET=your_google_auth_secret
KXPRESS_CLIENT_ID=your_konga_client_id
KXPRESS_SECRET_KEY=your_konga_secret_key

# ── Social / Meta Marketing APIs ────────────────────────────────────────────
FACEBOOK_APP_ID=your_fb_app_id
FACEBOOK_APP_SECRET=your_fb_app_secret
FACEBOOK_TOKEN=your_fb_access_token
FACEBOOK_AD_ACCOUNT_ID=act_your_ad_account_id
FACEBOOK_PAGE_ID=your_page_id
FACEBOOK_LOGIN_APP_ID=your_fb_login_app_id
FACEBOOK_LOGIN_APP_SECRET=your_fb_login_app_secret

# ── Identity / Verification Partner ─────────────────────────────────────────
MYAZA_PUBLISHABLE=your_myaza_publishable_key
MYAZA_SECRET=your_myaza_secret_key
MYAZA_KYC_WORKFLOW_ID=your_kyc_workflow_id
MYAZA_KYB_WORKFLOW_ID=your_kyb_workflow_id
MYAZA_WEBHOOK_SECRET=your_myaza_webhook_secret
